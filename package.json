{
  "name": "celestialsculptor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "serve": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "lint": "oxlint --deny-warnings web tests scripts playwright.config.js",
    "format": "prettier --write \"web/**/*.{js,css}\" \"tests/**/*.{js,mjs}\" \"scripts/**/*.mjs\" playwright.config.js",
    "format:check": "prettier --check \"web/**/*.{js,css}\" \"tests/**/*.{js,mjs}\" \"scripts/**/*.mjs\" playwright.config.js",
    "bench": "node scripts/benchmark.mjs",
    "bench:simd": "node scripts/simd-benchmark.mjs",
    "verify": "node scripts/verify.mjs",
    "report": "node scripts/release-report.mjs",
    "audit": "node scripts/audit-design.mjs",
    "bench:gravity": "node scripts/gravity-benchmark.mjs",
    "bench:scaling": "node scripts/scaling-benchmark.mjs",
    "bench:parallel": "node scripts/parallel-benchmark.mjs",
    "compare:scaling": "node scripts/compare-scaling.mjs",
    "profile:scaling": "node scripts/profile-scaling.mjs",
    "bench:tuning": "node scripts/tune-gravity.mjs",
    "qualify:numerics": "node scripts/qualify-numerics.mjs",
    "qualify:split": "node scripts/qualify-numerics.mjs split",
    "qualify:devices": "node scripts/qualify-devices.mjs",
    "compare:swarm": "node scripts/compare-swarm.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "oxlint": "1.83.0",
    "prettier": "3.9.8"
  },
  "license": "MIT"
}
